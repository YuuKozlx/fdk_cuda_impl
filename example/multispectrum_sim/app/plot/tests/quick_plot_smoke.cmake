file(MAKE_DIRECTORY "${TEST_DIR}")
file(WRITE "${TEST_DIR}/输入数据.csv" "x,y,group\n0,0,1\n1,1,1\n2,4,2\n")
file(WRITE "${TEST_DIR}/valid.json" [=[{"output":"曲线.png","panels":[{"type":"line","file":"输入数据.csv","x":"x","y":"y","where":{"group":1}}]}]=])
execute_process(COMMAND "${EXE}" "${TEST_DIR}/valid.json" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "Valid Unicode CSV/config failed: ${out} ${err}")
endif()
file(READ "${TEST_DIR}/曲线.png" signature LIMIT 8 HEX)
if(NOT signature STREQUAL "89504e470d0a1a0a")
  message(FATAL_ERROR "Invalid exported PNG signature")
endif()
file(WRITE "${TEST_DIR}/missing-column.json" [=[{"output":"bad.png","panels":[{"file":"输入数据.csv","y":"missing"}]}]=])
file(WRITE "${TEST_DIR}/bad-layout.json" [=[{"rows":0,"panels":[{"file":"输入数据.csv"}]}]=])
file(WRITE "${TEST_DIR}/empty-filter.json" [=[{"output":"bad.png","panels":[{"file":"输入数据.csv","where":{"group":99}}]}]=])
file(WRITE "${TEST_DIR}/ragged.csv" "1,2\n3\n")
file(WRITE "${TEST_DIR}/ragged.json" [=[{"output":"bad.png","panels":[{"type":"heatmap","file":"ragged.csv"}]}]=])
file(WRITE "${TEST_DIR}/nan.csv" "x,y\n1,nan\n")
file(WRITE "${TEST_DIR}/nan.json" [=[{"output":"bad.png","panels":[{"file":"nan.csv"}]}]=])
foreach(case missing-column bad-layout empty-filter ragged nan)
  execute_process(COMMAND "${EXE}" "${TEST_DIR}/${case}.json" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(rc EQUAL 0)
    message(FATAL_ERROR "Invalid ${case} accepted")
  endif()
endforeach()
execute_process(COMMAND "${EXE}" "${TEST_DIR}/valid.json" --panel 0 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(rc EQUAL 0)
  message(FATAL_ERROR "Invalid panel zero accepted")
endif()
message(STATUS "Quick plot: Unicode path, PNG, filtering and invalid-input checks passed")
