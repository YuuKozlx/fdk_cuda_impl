# Prefer the SDK's CMake package; accept a standard header/static-library SDK too.
find_package(matio ${matio_FIND_VERSION} CONFIG QUIET)
if(TARGET matio::matio)
    set(matio_FOUND TRUE)
    return()
endif()
find_path(MATIO_INCLUDE_DIR matio.h PATH_SUFFIXES include)
find_library(MATIO_LIBRARY NAMES matio libmatio PATH_SUFFIXES lib)
if(MATIO_INCLUDE_DIR AND EXISTS "${MATIO_INCLUDE_DIR}/matio_pubconf.h")
    file(STRINGS "${MATIO_INCLUDE_DIR}/matio_pubconf.h" version_line REGEX "^#define MATIO_VERSION_STR ")
    string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" MATIO_VERSION "${version_line}")
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(matio REQUIRED_VARS MATIO_LIBRARY MATIO_INCLUDE_DIR VERSION_VAR MATIO_VERSION)
if(matio_FOUND AND NOT TARGET matio::matio)
    set(ZLIB_USE_STATIC_LIBS ON)
    find_package(ZLIB REQUIRED)
    add_library(matio::matio UNKNOWN IMPORTED)
    set_target_properties(matio::matio PROPERTIES IMPORTED_LOCATION "${MATIO_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${MATIO_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES ZLIB::ZLIB)
    if(UNIX AND NOT APPLE)
        set_property(TARGET matio::matio APPEND PROPERTY INTERFACE_LINK_LIBRARIES m)
    endif()
endif()
mark_as_advanced(MATIO_INCLUDE_DIR MATIO_LIBRARY)
