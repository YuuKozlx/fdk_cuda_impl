# YKCBCTConfig.cmake.in
#
# find_package(YKCBCT CONFIG REQUIRED) 时 CMake 会找到并执行
# configure_package_config_file 渲染后的 YKCBCTConfig.cmake。
#
# @PACKAGE_INIT@ 由 configure_package_config_file 展开，
# 生成一段路径规范化代码，使本文件在任意安装位置都能
# 正确定位同目录下的 YKCBCTTargets.cmake。

@PACKAGE_INIT@

# 加载 target 定义文件，执行后 YKCBCT::YKCBCT 这个 imported target 就存在了
include("${CMAKE_CURRENT_LIST_DIR}/YKCBCTTargets.cmake")

# 验证外部请求的 COMPONENTS 是否都存在
# 目前只有一个组件 YKCBCT，后续可扩展（如 YKCBCT::FDK、YKCBCT::FP 等）
check_required_components(YKCBCT)
